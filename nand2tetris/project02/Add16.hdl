// File name: projects/2/Add16.hdl
/**
 * 16-bit adder: Adds two 16-bit two's complement values.
 * The most significant carry bit is ignored.
 */
CHIP Add16 {
    IN a[16], b[16];
    OUT out[16];

    PARTS:
    FullAdder(a= a[0], b= b[0], c= false, sum= out[0], carry= cin1);
    FullAdder(a= a[1], b= b[1], c= cin1, sum= out[1], carry= cin2);
    FullAdder(a= a[2], b= b[2], c= cin2, sum= out[2], carry= cin3);
    FullAdder(a= a[3], b= b[3], c= cin3, sum= out[3], carry= cin4);
    FullAdder(a= a[4], b= b[4], c= cin4, sum= out[4], carry= cin5);
    FullAdder(a= a[5], b= b[5], c= cin5, sum= out[5], carry= cin6);
    FullAdder(a= a[6], b= b[6], c= cin6, sum= out[6], carry= cin7);
    FullAdder(a= a[7], b= b[7], c= cin7, sum= out[7], carry= cin8);
    FullAdder(a= a[8], b= b[8], c= cin8, sum= out[8], carry= cin9);
    FullAdder(a= a[9], b= b[9], c= cin9, sum= out[9], carry= cin10);
    FullAdder(a= a[10], b= b[10], c= cin10, sum= out[10], carry= cin11);
    FullAdder(a= a[11], b= b[11], c= cin11, sum= out[11], carry= cin12);
    FullAdder(a= a[12], b= b[12], c= cin12, sum= out[12], carry= cin13);
    FullAdder(a= a[13], b= b[13], c= cin13, sum= out[13], carry= cin14);
    FullAdder(a= a[14], b= b[14], c= cin14, sum= out[14], carry= cin15);
    FullAdder(a= a[15], b= b[15], c= cin15, sum= out[15], carry= cin16);
}