// File name: projects/1/Or.hdl
/**
 * Or gate:
 * if (a or b) out = 1, else out = 0 
 */
CHIP Or {
    IN a, b;
    OUT out;


    PARTS:
        Nand(a = a, b =a, out = a1);
        Nand(a = b, b = b, out = b1);
        Nand(a = a1, b = b1, out = c1);
        Nand(a = c1, b = c1, out = d1);
        Nand(a = d1, b = d1, out = out);
}